<!-- Fase 3: mesma exclusao de data_extraction_rules.xml, so que pro backup
     automatico legado (Android 6 a 11, API 23-30). Ver comentario naquele
     arquivo pro motivo. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
