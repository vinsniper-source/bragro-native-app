<?xml version="1.0" encoding="utf-8"?>
<!-- Fase 3: regras de backup automatico (Android 12+, API 31+). Exclui o
     DataStore de tokens (access/refresh token da sessao Supabase, ver
     data/TokenStore.kt) tanto do backup na nuvem quanto da transferencia
     direta entre aparelhos: um token restaurado num aparelho novo, ou
     tempo depois num backup antigo, pode estar expirado/revogado, e nao
     ha motivo pra guardar credencial de sessao fora do aparelho onde ela
     foi criada. O cache offline dos lancamentos (Room) e as configuracoes
     do app continuam sendo salvos normalmente. -->
<!-- v72b: nada do app vai para backup nem para outro aparelho (sessão,
     registros offline e configurações ficam só neste celular). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
