<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Baixar/instalar o APK de atualização direto pelo DownloadManager
         nativo, em vez de abrir o link num Custom Tab do navegador:
         corrige bug real ("o download vai até o final mas não aparece a
         mensagem concluído, fica em looping infinito"), causado pelo
         navegador dentro do Custom Tab não reportar de volta pro app
         quando o download termina, deixando a UI "pendurada".
         Ver ApkInstaller.kt. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- GPS na captura de pragas: pedido do usuario (gap analysis, eixo
         Campo/Precisao). Best-effort: se o usuario negar, o app segue
         funcionando normalmente sem coordenada (Praga.latitude/longitude
         sao opcionais); ver PragaFotoScreen.kt. Sem play-services-location
         de proposito (nao adiciona dependencia nova): usa LocationManager
         nativo do Android (getLastKnownLocation), suficiente pra um registro
         de campo pontual. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Ícones de câmera/QR Code não abriam em alguns aparelhos (relatado
         pelo usuário: Romaneio, Abastecimento rápido/QR da Frota) mesmo com
         <queries>/FileProvider corretos; causa real: o app nunca declarava
         nem pedia a permissão CAMERA em tempo de execução, e vários apps de
         câmera de fabricante (Xiaomi/MIUI, Samsung) recusam SILENCIOSAMENTE
         o Intent implícito ACTION_IMAGE_CAPTURE quando o app chamador não
         tem essa permissão concedida; o launch() não dá erro nenhum, só
         não acontece nada visível, exatamente o sintoma relatado. Cada tela
         com ícone de câmera agora pede essa permissão (runtime, Android 6+)
         antes de abrir a câmera; ver rememberLauncherForActivityResult
         (RequestPermission) em QuickAbastecimentoDialog/RomaneioQuickScreen/
         PragaFotoScreen/OrcamentoScreen. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Necessario a partir do Android 11 (targetSdk 30+, aqui targetSdk 34):
         sem declarar a intent de camera aqui, o sistema pode nao conseguir
         RESOLVER o app de camera pra abrir via Intent implicito
         (MediaStore.ACTION_IMAGE_CAPTURE) em alguns aparelhos/ROMs,
         derrubando o app com ActivityNotFoundException ao tocar em "Tirar
         foto" (bug relatado pelo usuario no Romaneio Rapido, mesmo apos
         reinstalar a versao mais atual; essa e a causa mais provavel
         numa instalacao limpa, ja que o restante do fluxo, FileProvider e
         file_paths.xml, ja estava correto).

         CAUSA RAIZ REAL do "QR ainda nao abre" (persistente mesmo apos
         #852/#868/#875/#883): a v1.3.25 (#883) tentou um 2o leitor via
         Intent implicito pra action "com.google.zxing.client.android.SCAN"
         (a action do antigo app "ZXing Barcode Scanner"). O usuario
         confirmou com screenshot do proprio aparelho que NENHUM app
         moderno responde mais a essa action, nem mesmo depois dela ter
         sido declarada aqui em <queries> (correcao anterior, #896);
         resolveActivity() continuava sem achar ninguem. Troca (#896): em
         vez de depender de um Intent implicito pra um app de terceiros que
         nao existe mais, o leitor nativo agora usa a Code Scanner API do
         Google Play Services (GmsBarcodeScanning, ver
         iniciarLeitorQrNativo em CameraPermissionUtils.kt), uma chamada
         de API direta, sem Intent implicito nenhum e sem precisar de
         entrada em <queries>, por isso a action do ZXing foi removida
         daqui. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- required="false": sem uses-feature camera explicito, o Android
         assume required="true" por padrao, o que (a) restringe a
         visibilidade/instalacao do app na Play Store a SOMENTE aparelhos
         com camera, escondendo o app de qualquer tablet/coletor de dados
         de campo sem camera que o usuario (agro) possa usar so pros demais
         modulos, e (b) em instalacoes via APK direto (fora da Play Store,
         como este app distribui as atualizacoes - ver ApkInstaller.kt),
         pode fazer o PackageManager filtrar/recusar a resolucao de
         componentes de camera em builds mais restritos. Nenhuma tela do
         app depende de ter camera obrigatoriamente: todas as 4 (Romaneio,
         Pragas, Orcamentos, Abastecimento/Frota QR) ja tratam "nenhum app
         de camera disponivel" (temAppDeCameraDisponivel) e "nenhum leitor
         de QR disponivel" de forma graciosa, sem travar o app. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".BRAgroApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="BRAgro"
        android:theme="@style/Theme.BRAgro"
        android:usesCleartextTraffic="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <!-- Sentry: inicializado manualmente em BRAgroApplication.initSentry()
             (so em release). Desliga o auto-init do SDK pra nao inicializar duas vezes. -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />


        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BRAgro.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fase 2 (Task #42): FileProvider so pra dar ao app da Camera um
             content:// URI onde salvar a foto do ticket (delegando a
             captura pro app de Camera do sistema via Intent implicito:
             por isso NAO e preciso declarar permissao de CAMERA aqui, o
             acesso ao hardware acontece no processo do app de Camera). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
