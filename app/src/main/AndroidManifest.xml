<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Baixar/instalar o APK de atualização direto pelo DownloadManager
         nativo, em vez de abrir o link num Custom Tab do navegador:
         corrige bug real ("o download vai até o final mas não aparece a
         mensagem concluído, fica em looping infinito"), causado pelo
         navegador dentro do Custom Tab não reportar de volta pro app
         quando o download termina, deixando a UI "pendurada".
         Ver ApkInstaller.kt. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".BRAgroApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="BRAgro"
        android:theme="@style/Theme.BRAgro"
        android:usesCleartextTraffic="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BRAgro.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fase 2 (Task #42): FileProvider so pra dar ao app da Camera um
             content:// URI onde salvar a foto do ticket (delegando a
             captura pro app de Camera do sistema via Intent implicito:
             por isso NAO e preciso declarar permissao de CAMERA aqui, o
             acesso ao hardware acontece no processo do app de Camera). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
