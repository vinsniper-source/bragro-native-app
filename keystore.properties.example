# Copie este arquivo pra "keystore.properties" (na raiz do native-app, do
# lado deste .example) e preencha com os dados reais do SEU keystore.
# "keystore.properties" fica de fora do git (ver .gitignore) -- NUNCA
# comite senha nem o arquivo do keystore em si.
#
# Como gerar um keystore novo (rode uma vez so, guarde o arquivo gerado e as
# senhas em lugar seguro -- se perder, nao tem como atualizar o app publicado
# na Play Store nunca mais, precisaria publicar como um app novo):
#
#   keytool -genkeypair -v -keystore bragro-release.jks -alias bragro -keyalg RSA -keysize 2048 -validity 10000
#
# Depois mova o bragro-release.jks pra algum lugar seguro (fora do repositorio)
# e aponte "storeFile" abaixo pro caminho completo dele.

storeFile=C:/caminho/completo/para/bragro-release.jks
storePassword=SENHA_DO_KEYSTORE
keyAlias=bragro
keyPassword=SENHA_DA_CHAVE
